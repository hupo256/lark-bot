#!/bin/sh
# 回放出网审计壳（docs/falive-replay-design-v2.md §8 前置 7）：run-sim 把本目录放在 PATH 最前，bot 的 claude 会话里调 curl 先记一笔目标
# （方法 + 主机 + 路径，不记 query / 头 / 正文）到 $SIM_DIR/egress.log，再原样交给真 curl。只记不拦，违规在 round-report 里标出。
here=$(cd "$(dirname "$0")" && pwd)
node "$here/../egress-log.mjs" curl "$@" 2>/dev/null
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$here" | paste -sd: -)
export PATH
exec curl "$@"
