{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lark AI task analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "applicableRules", "requirements", "blockers"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "applicableRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "application"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "application": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
