{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lark mentioned-message intent classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "confidence",
    "summary",
    "reason"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "bug",
        "requirement",
        "api_reply",
        "ignore"
      ],
      "description": "bug=缺陷反馈；requirement=交办的新增/调整；api_reply=对方（后端/运维/产品）对我方对接问题的答复或接口/字段/环境变化，需要据此更新前端或复核；ignore=闲聊/知会/催办"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "forMe": {
      "type": "boolean",
      "description": "这件事是否需要本 bot 代理的那个人（提示里的负责人）动前端代码或复核前端；不是他的事填 false"
    }
  }
}
